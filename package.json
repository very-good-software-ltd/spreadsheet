{
  "name": "very-good-spreadsheet",
  "version": "0.1.0",
  "description": "A very good spreadsheet library",
  "keywords": [
    "spreadsheet",
    "excel",
    "xlsx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/christophgockel/very-good-spreadsheet"
  },
  "license": "MIT",
  "author": "Christoph Gockel",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.0.0",
    "@typescript/typescript6": "^6.0.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
