{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "biome check --error-on-warnings",
    "lint:ci": "biome ci --error-on-warnings",
    "lint:fix": "biome check --write",
    "lint:routes": "react-router-lint-routes --tsconfig tsconfig.vite.json",
    "lint:verify": "npm run lint && npm run lint:routes",
    "preview": "vite preview --outDir build/client",
    "test": "vitest",
    "typecheck": "react-router typegen && tsc -b",
    "verify": "npm run lint:verify && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "isbot": "^5.2.1",
    "morgan": "^1.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-shiki": "^0.11.0",
    "very-good-spreadsheet": "file:.."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.11.1",
    "react-router-lint-routes": "^1.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
