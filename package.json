{
  "name": "@very-good-software/spreadsheet",
  "version": "0.5.0",
  "description": "Streaming reader for Excel .xlsx and OpenDocument .ods, in Node and the browser.",
  "homepage": "https://spreadsheet.verygoodsoftware.net",
  "keywords": [
    "excel",
    "ods",
    "opendocument",
    "spreadsheet",
    "streaming",
    "xlsx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophgockel/very-good-spreadsheet.git"
  },
  "license": "MIT",
  "author": "Christoph Gockel",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "benchmark": "npm run build && node benchmark/run.mjs",
    "benchmark:read": "npm run build && node benchmark/run.mjs --read",
    "benchmark:write": "npm run build && node benchmark/run.mjs --write",
    "build": "vite build && tsc -p tsconfig.build.json",
    "examples": "node scripts/sync-examples.mjs",
    "examples:check": "node scripts/sync-examples.mjs --check",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "manual-check": "npm run build && node scripts/manual-check.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "typecheck": "tsc",
    "verify": "npm run lint && npm run typecheck && npm run examples:check && npm run test"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.0.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
